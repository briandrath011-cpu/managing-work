local DamageFormula = require(Modules.Combat.DamageFormula)
local Modifiers = require(Modules.Combat.Modifiers)

describe("DamageFormula", function()
	local rng = Random.new(1)

	it("returns base damage with no modifiers", function()
		local dmg, crit = DamageFormula.Compute({ Base = 100 }, rng)
		expect(dmg).toBe(100)
		expect(crit).toBeFalsy()
	end)

	it("scales with the stat", function()
		local low = DamageFormula.Compute({ Base = 100, Stat = 0 }, rng)
		local high = DamageFormula.Compute({ Base = 100, Stat = 100 }, rng)
		expect(high).toBe(math.floor(100 * (1 + 100 * DamageFormula.StatScale) + 0.5))
		expect(high).toBeGreaterThan(low)
	end)

	it("defense reduces damage but never below 1", function()
		local dmg = DamageFormula.Compute({ Base = 100, Defense = 100 }, rng)
		expect(dmg).toBe(50)
		local tiny = DamageFormula.Compute({ Base = 1, Defense = 100000 }, rng)
		expect(tiny).toBe(1)
	end)

	it("forced crit applies the crit multiplier", function()
		local dmg, crit = DamageFormula.Compute({ Base = 100, ForceCrit = true, CritMultiplier = 2 }, rng)
		expect(crit).toBeTruthy()
		expect(dmg).toBe(200)
	end)

	it("blocking multiplies damage", function()
		local dmg = DamageFormula.Compute({ Base = 100, BlockMultiplier = 0.2 }, rng)
		expect(dmg).toBe(20)
	end)

	it("level difference is clamped", function()
		expect(DamageFormula.LevelFactor(200, 1)).toBe(DamageFormula.MaxLevelFactor)
		expect(DamageFormula.LevelFactor(1, 200)).toBe(DamageFormula.MinLevelFactor)
	end)

	it("damage reduction is capped at 90%", function()
		local dmg = DamageFormula.Compute({ Base = 1000, DamageReduction = 5 }, rng)
		expect(dmg).toBe(100)
	end)
end)

describe("Modifiers", function()
	it("aggregates bonuses from several sources", function()
		local total = Modifiers.Aggregate({ { DamageMult = 0.1 }, { DamageMult = 0.05, MoveSpeed = 3 }, nil })
		expect(total.DamageMult).toBeCloseTo(0.15)
		expect(total.MoveSpeed).toBe(3)
		expect(total.CritChance).toBe(0)
	end)

	it("applies hard caps", function()
		local total = Modifiers.Aggregate({ { DamageReduction = 5, CritChance = 5, CooldownReduction = 5 } })
		expect(total.DamageReduction).toBe(Modifiers.Caps.DamageReduction)
		expect(total.CritChance).toBe(Modifiers.Caps.CritChance)
		expect(total.CooldownReduction).toBe(Modifiers.Caps.CooldownReduction)
	end)

	it("ignores unknown keys", function()
		local total = Modifiers.Aggregate({ { NotAStat = 99 } })
		expect(total.NotAStat).toBe(nil)
	end)
end)
